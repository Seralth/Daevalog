# Package of the meter for Arch and derivatives (CachyOS, Manjaro,
# EndeavourOS).
#
# Builds from the repository this file sits in, not from a downloaded
# tarball: CI builds it with `makepkg` in an Arch container (see
# .github/workflows/arch-package.yml), and so can anyone from a checkout.
#
# It installs the program to /usr/bin, the game data where Tauri looks for
# resources (/usr/lib/<product name>/data), and grants packet-capture
# permission in the install script, which is the one thing a Linux user would
# otherwise have to do by hand (see daevalog-dps-meter.install).

pkgname=daevalog-dps-meter
# The fork's revisions replaced the upstream version numbers; the epoch keeps
# them newer than the 2.0.x packages for pacman.
epoch=1
pkgver=0
pkgrel=1
pkgdesc="Daevalog DPS Meter: real-time DPS overlay for AION 2 (Linux/Proton)"
arch=('x86_64')
url="https://github.com/Seralth/Daevalog"
license=('GPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'libpcap' 'libcap' 'hicolor-icon-theme' 'libayatana-appindicator')
makedepends=('rust' 'nodejs' 'npm' 'git' 'pkgconf')
optdepends=('gtk-layer-shell: overlay as a Wayland layer above fullscreen games (KDE Plasma, Hyprland, Sway)')
install=daevalog-dps-meter.install
# The package was a2tools-dps-meter before the fork was renamed.
conflicts=('a2tools-dps-meter')
replaces=('a2tools-dps-meter')
options=('!lto' '!debug')

# The repository root, two levels up from packaging/arch.
_root() {
  cd "$startdir/../.." && pwd
}

# r<commits>.g<hash>: the commit count orders builds, the hash names the
# commit. The upstream release the fork is based on stays in Cargo.toml.
pkgver() {
  cd "$(_root)"
  # Fail rather than print "r.g" when git cannot read the history (a
  # worktree's .git file pointing outside the build container).
  local count hash
  count=$(git rev-list --count HEAD) && hash=$(git rev-parse --short HEAD) || return 1
  printf 'r%s.g%s' "$count" "$hash"
}

build() {
  cd "$(_root)"
  # Files a clean checkout lacks (they are gitignored mirrors of src/data).
  mkdir -p public/i18n public/data public/src/data
  cp -r src/data/i18n/* public/i18n/
  cp src/data/skill_icons.json src/data/dot_skill_ids.json public/data/
  cp src/data/skill_icons.json src/data/dot_skill_ids.json public/src/data/
  npm ci
  npx tauri build --no-bundle
}

package() {
  local root
  root="$(_root)"
  install -Dm755 "$root/src-tauri/target/release/daevalog-dps-meter" "$pkgdir/usr/bin/daevalog-dps-meter"

  # Tauri resolves resources to /usr/lib/<name>; ship both spellings of the
  # name so either resolution finds the data.
  install -d "$pkgdir/usr/lib/Daevalog DPS Meter"
  cp -r "$root/src/data" "$pkgdir/usr/lib/Daevalog DPS Meter/data"
  ln -s "Daevalog DPS Meter" "$pkgdir/usr/lib/daevalog-dps-meter"

  install -Dm644 "$root/src-tauri/icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/daevalog-dps-meter.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/daevalog-dps-meter.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Daevalog DPS Meter
Comment=Real-time DPS overlay for AION 2
Exec=daevalog-dps-meter
Icon=daevalog-dps-meter
Categories=Game;Utility;
DESKTOP
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
